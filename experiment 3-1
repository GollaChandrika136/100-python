      "source": [
        "import nltk\n",
        "from nltk.tokenize import sent_tokenize, word_tokenize\n",
        "from nltk import pos_tag\n",
        "\n",
        "# Download the required resource for pos_tag\n",
        "nltk.download('averaged_perceptron_tagger_eng')\n",
        "\n",
        "\n",
        "# Sample Input\n",
        "paragraph = \"\"\"Notice of a bid advertisement shall be published in at least one local newspaper and in one trade\n",
        "publication at least 30 days in advance of sale. If applicable, the notice must identify the reservation\n",
        "within which the tracts to be leased are found. Specific descriptions of the tracts shall be available\n",
        "at the office of the superintendent. The complete text of the advertisement shall be mailed to each\n",
        "person listed on the appropriate agency mailing list.\"\"\"\n",
        "\n",
        "# Sentence Tokenization\n",
        "sentences = sent_tokenize(paragraph)\n",
        "\n",
        "for sent in sentences:\n",
        "    words = word_tokenize(sent)\n",
        "    tagged = pos_tag(words)\n",
        "    print(tagged)"
      ],
