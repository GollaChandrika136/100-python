        "import spacy\n",
        "\n",
        "# Load English model\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "# Sample Input Paragraph\n",
        "paragraph = \"Gowtham is an English lecturer who planned to conduct an exam for all the students in the college.\"\n",
        "\n",
        "# Process the paragraph\n",
        "doc = nlp(paragraph)\n",
        "\n",
        "# Remove stop words and punctuation\n",
        "filtered_words = [token.text for token in doc if not token.is_stop and token.is_alpha]\n",
        "\n",
        "# Identify Parts of Speech\n",
        "pos_tags = [(token.text, token.pos_) for token in doc if not token.is_stop and token.is_alpha]\n",
        "\n",
        "# Output\n",
        "print(\"Filtered Words:\", filtered_words)\n",
        "print(\"\\nParts of Speech:\")\n",
        "for word, pos in pos_tags:\n",
        "    print(f\"{word} → {pos}\")\n"
