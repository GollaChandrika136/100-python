      "source": [
        "import nltk\n",
        "from nltk import PCFG\n",
        "from nltk.parse import ViterbiParser\n",
        "\n",
        "# Define two toy grammars\n",
        "toy_pcfg1 = PCFG.fromstring(\"\"\"\n",
        "  S -> NP VP [1.0]\n",
        "  NP -> Name [0.5] | Det N [0.5]\n",
        "  VP -> V NP [1.0]\n",
        "  Name -> 'Jack' [1.0]\n",
        "  Det -> 'the' [1.0]\n",
        "  N -> 'cookie' [0.5] | 'sandwich' [0.5]\n",
        "  V -> 'ate' [1.0]\n",
        "\"\"\")\n",
        "\n",
        "toy_pcfg2 = PCFG.fromstring(\"\"\"\n",
        "  S -> NP VP [1.0]\n",
        "  NP -> Name [0.6] | Det N [0.4]\n",
        "  VP -> V NP [1.0]\n",
        "  Name -> 'Jack' [1.0]\n",
        "  Det -> 'the' [1.0]\n",
        "  N -> 'cookie' [0.7] | 'sandwich' [0.3]\n",
        "  V -> 'ate' [1.0]\n",
        "\"\"\")\n",
        "\n",
        "# a) Print words and productions in toy_pcfg1\n",
        "print(\"toy_pcfg1 productions:\")\n",
        "print(toy_pcfg1.productions())\n",
        "print(\"Words:\", [p.rhs()[0] for p in toy_pcfg1.productions() if isinstance(p.rhs()[0], str)])\n",
        "\n",
        "# b) Print words and productions in toy_pcfg2\n",
        "print(\"\\ntoy_pcfg2 productions:\")\n",
        "print(toy_pcfg2.productions())\n",
        "print(\"Words:\", [p.rhs()[0] for p in toy_pcfg2.productions() if isinstance(p.rhs()[0], str)])\n",
        "\n",
        "# c) Parse a sentence using Viterbi Parser\n",
        "sentence = ['Jack', 'ate', 'the', 'cookie']\n",
        "parser = ViterbiParser(toy_pcfg1)   # try with toy_pcfg2 also\n",
        "for tree in parser.parse(sentence):\n",
        "    print(\"\\nBest Parse Tree:\", tree)\n",
        "    print(\"Probability:\", tree.prob())\n"
      ],
