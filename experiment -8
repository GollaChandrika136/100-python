      "source": [
        "import nltk\n",
        "from nltk import ConditionalFreqDist, bigrams\n",
        "\n",
        "# --------------------------\n",
        "# Sample text for \"Brown corpus\" style\n",
        "brown_sample = {\n",
        "    'fiction': \"Once upon a time there was a king who loved his kingdom\".split(),\n",
        "    'lore': \"In ancient times, people told stories of gods and heroes\".split()\n",
        "}\n",
        "\n",
        "# Build CFD for sample genres\n",
        "cfd_brown = ConditionalFreqDist(\n",
        "    (genre, word)\n",
        "    for genre, words in brown_sample.items()\n",
        "    for word in words\n",
        ")\n",
        "\n",
        "# Print most common words in each genre\n",
        "for genre in brown_sample:\n",
        "    print(f\"\\nMost common words in {genre}:\")\n",
        "    print(cfd_brown[genre].most_common())\n",
        "\n",
        "# --------------------------\n",
        "# Sample text for UDHR style corpus\n",
        "udhr_sample = {\n",
        "    'Chickasaw': \"I am a person and I have rights\".split(),\n",
        "    'English': \"All humans are born free and equal in dignity\".split(),\n",
        "    'German_Deutsch': \"Alle Menschen sind frei und gleich an Würde geboren\".split()\n",
        "}\n",
        "\n",
        "target_freqs = [1, 2]  # Use small numbers since the sample is small\n",
        "\n",
        "cfd_udhr = ConditionalFreqDist(\n",
        "    (lang, word)\n",
        "    for lang, words in udhr_sample.items()\n",
        "    for word in words\n",
        ")\n",
        "\n",
        "# Tabulate frequency counts\n",
        "print(\"\\nWord frequency counts for sample UDHR corpus:\")\n",
        "for lang in udhr_sample:\n",
        "    print(f\"\\nLanguage: {lang}\")\n",
        "    for freq in target_freqs:\n",
        "        count = sum(1 for w in cfd_udhr[lang] if cfd_udhr[lang][w] == freq)\n",
        "        print(f\"Words with frequency {freq}: {count}\")\n",
        "\n",
        "# --------------------------\n",
        "# Sample text for bigrams generation\n",
        "sample_text = \"darkness falls across the land the wind is howling like the sea\".split()\n",
        "bi_grams = list(bigrams(sample_text))\n",
        "print(\"\\nBigrams from sample text:\")\n",
        "print(bi_grams)\n",
        "\n",
        "# Generate 15-word sentence using bigram CFD\n",
        "cfd_bi = ConditionalFreqDist(bigrams(sample_text))\n",
        "word = \"darkness\"\n",
        "sentence = [word]\n",
        "for i in range(14):\n",
        "    if word in cfd_bi:\n",
        "        next_word = list(cfd_bi[word].keys())[0]  # pick the first possible next word\n",
        "        sentence.append(next_word)\n",
        "        word = next_word\n",
        "    else:\n",
        "        break\n",
        "\n",
        "print(\"\\nGenerated 15-word sentence using bigram CFD:\")\n",
        "print(\" \".join(sentence))\n"
      ],
