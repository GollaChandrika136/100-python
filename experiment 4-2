      "source": [
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from sklearn.decomposition import LatentDirichletAllocation\n",
        "\n",
        "# Sample documents\n",
        "docs = [\n",
        "    \"AI is transforming healthcare by using deep learning and computer vision.\",\n",
        "    \"Sports analytics is growing rapidly with the help of machine learning.\",\n",
        "    \"Natural language processing is useful in chatbots and translation.\",\n",
        "    \"Computer vision applications include self-driving cars and face recognition.\"\n",
        "]\n",
        "\n",
        "# Convert text to document-term matrix\n",
        "vectorizer = CountVectorizer(stop_words='english')\n",
        "X = vectorizer.fit_transform(docs)\n",
        "\n",
        "# Apply LDA\n",
        "lda = LatentDirichletAllocation(n_components=2, random_state=42)\n",
        "lda.fit(X)\n",
        "\n",
        "# Print topics\n",
        "words = vectorizer.get_feature_names_out()\n",
        "for i, topic in enumerate(lda.components_):\n",
        "    print(f\"Topic {i+1}:\")\n",
        "    print([words[j] for j in topic.argsort()[-5:]])\n"
