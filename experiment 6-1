      "source": [
        "from nltk import CFG, ChartParser\n",
        "\n",
        "# Define the grammar (CNF-like for CKY)\n",
        "grammar = CFG.fromstring(\"\"\"\n",
        "  S -> NP VP\n",
        "  PP -> P NP\n",
        "  NP -> Det N\n",
        "  NP -> Det N PP\n",
        "  NP -> 'I'\n",
        "  VP -> V NP\n",
        "  VP -> VP PP\n",
        "  Det -> 'an' | 'my'\n",
        "  N -> 'elephant' | 'pajamas'\n",
        "  V -> 'shot'\n",
        "  P -> 'in'\n",
        "\"\"\")\n",
        "\n",
        "# Create parser\n",
        "parser = ChartParser(grammar)\n",
        "\n",
        "# Input sentence\n",
        "sentence = ['I', 'shot', 'an', 'elephant', 'in', 'my', 'pajamas']\n",
        "\n",
        "# Generate parse trees\n",
        "for tree in parser.parse(sentence):\n",
        "    print(tree)\n",
        "    tree.pretty_print()\n"
      ],
